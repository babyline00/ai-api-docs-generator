# Absolute path to the SQLite database file (required for Prisma).
DATABASE_URL=file:/home/z/my-project/apps/89-ai-api-docs-generator/db/custom.db

# Optional LLM configuration. When unset, the AI layer falls back to a
# deterministic MockProvider so the app stays demoable offline. The
# z-ai-web-dev-sdk reads its own credentials from the environment when
# ZAI.create() is called.
PKC_DISABLE_LLM=0
